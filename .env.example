# MEETFLOW AI Environment Configuration

# OpenAI API Key (leave empty to run in automatic Demo Mode)
OPENAI_API_KEY=

# Optional: Custom OpenAI compatible base URL (e.g., https://api.groq.com/openai/v1 or local Ollama)
OPENAI_BASE_URL=

# Model Name to use for extraction & reports
OPENAI_MODEL=gpt-4o-mini

# Force Demo Mode even if key is present (true/false)
DEMO_MODE=false

# SQLite Database Path (defaults to ./data/meetflow.db)
DATABASE_URL=sqlite:///./data/meetflow.db
